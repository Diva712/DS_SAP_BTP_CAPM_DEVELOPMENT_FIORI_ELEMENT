{
  "xsappname": "sales",
  "tenant-mode": "shared",
  "scopes": [
    {
      "name": "$XSAPPNAME.Edit",
      "description": "edit"
    },
    {
      "name": "$XSAPPNAME.Display",
      "description": "display"
    },
    {
      "name": "$XSAPPNAME.Delete",
      "description": "delete"
    },
    {
      "name": "$XSAPPNAME.Create",
      "description": "create"
    }
  ],
  "foreign-scope-references": [
    "$ACCEPT_GRANTED_SCOPES"
  ],
  "authorities": [
    "$ACCEPT_GRANTED_AUTHORITIES"
  ],
  "attributes": [
    {
      "name": "Country",
      "description": "Country",
      "valueType": "string"
    },
    {
      "name": "OrderStatus",
      "description": "Order Status",
      "valueType": "string"
    }
  ],
  "role-templates": [
    {
      "name": "Editor",
      "description": "Can perform CRUD Operation",
      "scope-references": [
        "$XSAPPNAME.Edit",
        "$XSAPPNAME.Delete",
        "$XSAPPNAME.Display",
        "$XSAPPNAME.Create"
      ]
    },
    {
      "name": "Viewer",
      "description": "Read The data only",
      "scope-references": [
        "$XSAPPNAME.Display"
      ],
      "attribute-references": [
        "Country",
        "OrderStatus"
      ]
    }
  ],
  "oauth2-configuration": {
    "token-validity": 900,
    "refresh-token-validity": 1800,
    "redirect-uris": [
      "https://*.cfapps.us10-001.hana.ondemand.com/login/callback"    ],
    "autoapprove": "false",
    "system-attributes": [
      "groups",
      "rolecollections"
    ]
  }
}
