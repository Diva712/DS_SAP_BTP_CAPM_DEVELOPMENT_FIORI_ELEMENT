{
  "welcomeFile": "/webapp/index.html",
  "authenticationMethod": "route",
   "sessionTimeout": 10,
   "routes" : [
    {
      "source": "^/webapp/(.*)$",
      "target": "$1",
      "localDir": "webapp",
      "authenticationType": "none"
    },
    {
      "source": "^/odata/v4/(.*)$",
      "target": "/odata/v4/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    }
   ]

}  
